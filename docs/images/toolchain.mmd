    DIO --> DSVG[.drawio and .svg]
    VL[chart .vl.json] --> VL2[vl2svg]
    VL2 --> CSVG[chart .svg]
    MD[slides.md] --> MARP[Marp CLI]
    DSVG --> MARP
    CSVG --> MARP
    MARP --> HTML[HTML]
